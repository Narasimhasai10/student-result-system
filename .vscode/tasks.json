{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build C++ Backend (Release)",
            "type": "shell",
            "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/backend/build",
                "--config",
                "Release"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Build C++ Backend (Debug)",
            "type": "shell",
            "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
            "args": [
                "--build",
                "${workspaceFolder}/backend/build",
                "--config",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": [
                "$msCompile"
            ]
        },
        {
            "label": "Configure CMake",
            "type": "shell",
            "command": "C:\\Program Files\\CMake\\bin\\cmake.exe",
            "args": [
                "..",
                "-G",
                "Visual Studio 17 2022"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend/build"
            },
            "group": "build"
        },
        {
            "label": "Run C++ Backend Server",
            "type": "shell",
            "command": ".\\build\\bin\\Release\\server.exe",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Server running.*",
                    "endsPattern": "^.*"
                }
            }
        },
        {
            "label": "Run Crow Web Server",
            "type": "shell",
            "command": ".\\build\\bin\\Release\\web_server.exe",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        },
        {
            "label": "Clean Build Directory",
            "type": "shell",
            "command": "rmdir",
            "args": [
                "/s",
                "/q",
                "${workspaceFolder}\\backend\\build"
            ],
            "windows": {
                "command": "powershell",
                "args": [
                    "-Command",
                    "Remove-Item -Recurse -Force ${workspaceFolder}\\backend\\build"
                ]
            },
            "group": "build"
        },
        {
            "label": "Seed Database",
            "type": "shell",
            "command": "python",
            "args": [
                "seed_database.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            }
        },
        {
            "label": "Test API Health",
            "type": "shell",
            "command": "curl",
            "args": [
                "http://localhost:8080/api/health"
            ],
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "new"
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}